# ReconcileOps Environment Configuration
APP_NAME=ReconcileOps
APP_ENV=development
DEBUG=true
APP_SECRET_KEY=change-in-production-demo-secret-key-32chars!

# Database Configuration (Docker Compose sets this automatically to postgres)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/reconcileops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Mock Payment Provider
MOCK_PROVIDER_URL=http://localhost:8001
PROVIDER_REQUEST_TIMEOUT_SECONDS=10.0
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_FACTOR=0.5
PROVIDER_RETRY_AFTER_CAP_SECONDS=10.0

# Demo Mode & Safety Tokens
DEMO_MODE=true
DEMO_TOKEN=reconcileops-demo-secret-token

# Upload limits
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_ROWS=10000
